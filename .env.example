# --- Credenciais configuráveis pelo painel /admin/tokens ---
# (Você pode deixar estas vazias e preencher pelo painel depois de subir o app)
UAZAPI_URL=
UAZAPI_TOKEN=
OPENAI_API_KEY=
GOOGLE_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=

# --- Infraestrutura (não muda pelo painel) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CREDS=/code/service-account.json
WEBHOOK_TOKEN=

# --- Fotos de produtos no Google Cloud Storage (opcional) ---
# Sem GCS_BUCKET, uploads continuam no Postgres para compatibilidade.
GCS_BUCKET=
# Caminho do JSON ou o próprio JSON da service account. Se vazio, usa
# GOOGLE_APPLICATION_CREDENTIALS e depois GOOGLE_CALENDAR_CREDS.
GCS_CREDENTIALS=
# Opcional: URL de bucket público ou CDN, ex. https://storage.googleapis.com/meu-bucket
GCS_PUBLIC_BASE_URL=

# --- Painel admin ---
PAINEL_USER=admin
# Gere com: python -c "import hashlib;print(hashlib.sha256(b'SUA_SENHA').hexdigest())"
PAINEL_PASS_HASH=
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
